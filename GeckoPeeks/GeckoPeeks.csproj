<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- Keep the WebView2 package's .xml docs out of the output, so the publish folder holds only the exe. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <AssemblyName>GeckoPeeks</AssemblyName>
    <AssemblyName Condition="'$(GeckoPeeksDev)' == 'true'">GeckoPeeksDev</AssemblyName>
    <DefineConstants Condition="'$(GeckoPeeksDev)' == 'true'">$(DefineConstants);GECKO_PEEKS_DEV</DefineConstants>
    <RootNamespace>GeckoPeeks</RootNamespace>
    <Version>2.1.4</Version>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <AssemblyTitle>Gecko Peeks</AssemblyTitle>
    <Product>Gecko Peeks</Product>
    <Description>System-tray monitor for the route to Riot.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\gecko-peeks.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebView2 hosts the v2 UI. Single-file publish bundles WebView2Loader.dll through
         IncludeNativeLibrariesForSelfExtract, so the exe needs no loose files. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <!-- The web UI is served from these resources at https://gecko.peeks.invalid/.
         The logical name is "GeckoPeeks.Web/" plus the file name, so lookups do not
         depend on the default namespace mangling. -->
    <EmbeddedResource Include="Web\**\*" LogicalName="GeckoPeeks.Web/%(Filename)%(Extension)" />
    <!-- v2.1: the Worker's reference data, one copy for both. The page never loads it (other prefix). -->
    <EmbeddedResource Include="..\cloud\worker\data\refdata.json" LogicalName="GeckoPeeks.RefData/refdata.json" Link="RefData\refdata.json" />
  </ItemGroup>

  <!-- Decode Assets/gecko-peeks.ico.b64 when the binary .ico is missing (fresh clone). -->
  <Target Name="EnsureApplicationIcon" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_IconFile>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Assets', 'gecko-peeks.ico'))</_IconFile>
      <_IconB64>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Assets', 'gecko-peeks.ico.b64'))</_IconB64>
    </PropertyGroup>
    <Error Condition="!Exists('$(_IconB64)')" Text="Missing $(_IconB64). Restore the icon base64 before building." />
    <Exec Condition="!Exists('$(_IconFile)') AND $([MSBuild]::IsOSPlatform('Windows'))"
          Command="certutil -decode &quot;$(_IconB64)&quot; &quot;$(_IconFile)&quot;"
          IgnoreStandardErrorWarningFormat="true" />
    <Exec Condition="!Exists('$(_IconFile)') AND !$([MSBuild]::IsOSPlatform('Windows'))"
          Command="base64 -d &quot;$(_IconB64)&quot; &gt; &quot;$(_IconFile)&quot;" />
    <Error Condition="!Exists('$(_IconFile)')" Text="Could not materialize $(_IconFile) from $(_IconB64)." />
  </Target>
</Project>
